-- T-019: schema v4, batch C (database-schema.md §2.6–2.8; design note in
-- docs/04-tasks/tasks/T-019.md). Wealth, prices, Zakah, capture controls,
-- review queue, Gold templates, settings, secure state, outbox, voice usage,
-- undo batches and the diagnostic log. Batch A is financial.drift (v2),
-- batch B financial_b.drift (v3).
--
-- Money: integer minor units only (T-012): every amount column is CHECKed to
-- be an SQLite integer within ±(2^53 − 1), every currency column to be three
-- uppercase ASCII letters, and a nullable pair is both NULL or both set.
-- `unit` columns hold a currency code or a gold symbol (`XAU21_G`); for a
-- gold unit the amount is milligrams (like assets.quantity_milli).
--
-- Every INTEGER column is CHECKed `typeof(x) = 'integer'` (T-018 n-3), so a
-- REAL like 1.5 is refused. Every TEXT column with a form or length CHECK
-- also refuses NUL, tested on the bytes (`instr(CAST(x AS BLOB), x'00') =
-- 0`): SQLite's length() and GLOB stop at the first NUL (T-018 n-4), so
-- 'EGP' || char(0) || 'x' would pass a GLOB alone. Enum (`IN`) and date
-- (`date(x) IS x`) CHECKs compare all bytes and need no extra test. Names
-- and senders also refuse C0/C1 control characters.
-- ISO dates must be real dates: `date(x) IS x` (NULL-safe).

import 'financial.drift';

-- §2.6 Wealth (FR-WLT-02, Gold tier). Each asset in its native unit or
-- currency.
CREATE TABLE assets (
  id TEXT NOT NULL PRIMARY KEY,
  type TEXT NOT NULL
    CHECK (type IN ('gold', 'gold_coin', 'certificate', 'cash', 'stock_fund', 'real_estate', 'car', 'other')),
  name TEXT NOT NULL
    CHECK (length(name) BETWEEN 1 AND 60
      AND name NOT GLOB ('*[' || char(1) || '-' || char(31) || char(127) || '-' || char(159) || ']*')
      AND instr(CAST(name AS BLOB), x'00') = 0),
  currency TEXT CHECK (currency IS NULL OR (currency GLOB '[A-Z][A-Z][A-Z]' AND instr(CAST(currency AS BLOB), x'00') = 0)),
  quantity_milli INTEGER
    CHECK (quantity_milli IS NULL OR (typeof(quantity_milli) = 'integer'
      AND quantity_milli BETWEEN 1 AND 9007199254740991)),
  karat INTEGER
    CHECK (karat IS NULL OR (typeof(karat) = 'integer' AND karat IN (24, 22, 21, 18))),
  principal_minor INTEGER
    CHECK (principal_minor IS NULL OR (typeof(principal_minor) = 'integer'
      AND principal_minor BETWEEN 0 AND 9007199254740991)),
  rate_bp INTEGER
    CHECK (rate_bp IS NULL OR (typeof(rate_bp) = 'integer' AND rate_bp BETWEEN 0 AND 100000)),
  payout TEXT
    CHECK (payout IS NULL OR payout IN ('monthly', 'quarterly', 'semi_annual', 'annual', 'at_maturity')),
  maturity_date TEXT CHECK (maturity_date IS NULL OR date(maturity_date) IS maturity_date),
  manual_value_minor INTEGER
    CHECK (manual_value_minor IS NULL OR (typeof(manual_value_minor) = 'integer'
      AND manual_value_minor BETWEEN 0 AND 9007199254740991)),
  acquired_at TEXT CHECK (acquired_at IS NULL OR date(acquired_at) IS acquired_at),
  purchase_price_minor INTEGER
    CHECK (purchase_price_minor IS NULL OR (typeof(purchase_price_minor) = 'integer'
      AND purchase_price_minor BETWEEN 0 AND 9007199254740991)),
  purchase_currency TEXT
    CHECK (purchase_currency IS NULL OR (purchase_currency GLOB '[A-Z][A-Z][A-Z]'
      AND instr(CAST(purchase_currency AS BLOB), x'00') = 0)),
  is_liability INTEGER NOT NULL DEFAULT 0 CHECK (is_liability IN (0, 1)),
  archived_at INTEGER CHECK (archived_at IS NULL OR typeof(archived_at) = 'integer'),
  created_at INTEGER NOT NULL CHECK (typeof(created_at) = 'integer'),
  -- Money pairs (T-012): principal and manual value are in `currency`.
  CHECK (principal_minor IS NULL OR currency IS NOT NULL),
  CHECK (manual_value_minor IS NULL OR currency IS NOT NULL),
  CHECK ((purchase_price_minor IS NULL) = (purchase_currency IS NULL)),
  -- Gold has grams and a karat; certificates alone have rate, payout and
  -- maturity.
  CHECK (karat IS NULL OR type IN ('gold', 'gold_coin')),
  CHECK (type <> 'gold' OR (quantity_milli IS NOT NULL AND karat IS NOT NULL)),
  CHECK (type = 'certificate' OR (rate_bp IS NULL AND payout IS NULL AND maturity_date IS NULL))
) AS AssetRow;

CREATE INDEX ix_assets_live ON assets (type) WHERE archived_at IS NULL;

-- Gold and other prices (FR-WLT-03). The symbol is a form, not a closed set:
-- a new backend symbol must not fail the whole sync apply (FR-SYNC-03).
-- Symbols today: XAU24_G, XAU21_G, XAU18_G (per gram).
CREATE TABLE price_quotes (
  symbol TEXT NOT NULL
    CHECK (length(symbol) BETWEEN 1 AND 16 AND symbol GLOB '[A-Z]*'
      AND symbol NOT GLOB '*[^A-Z0-9_]*' AND instr(CAST(symbol AS BLOB), x'00') = 0),
  currency TEXT NOT NULL CHECK (currency GLOB '[A-Z][A-Z][A-Z]' AND instr(CAST(currency AS BLOB), x'00') = 0),
  price_minor INTEGER NOT NULL
    CHECK (typeof(price_minor) = 'integer' AND price_minor BETWEEN 1 AND 9007199254740991),
  per_unit TEXT NOT NULL
    CHECK (length(per_unit) BETWEEN 1 AND 16 AND per_unit NOT GLOB '*[^a-z0-9_]*'
      AND instr(CAST(per_unit AS BLOB), x'00') = 0),
  as_of INTEGER NOT NULL CHECK (typeof(as_of) = 'integer'),
  source TEXT NOT NULL CHECK (source IN ('backend', 'manual')),
  PRIMARY KEY (symbol, currency, source)
) AS PriceQuoteRow;

-- 1 base = rate_e9 / 1e9 quote. Display only (BR-FX-01): never used to
-- convert a stored amount.
CREATE TABLE fx_rates (
  base TEXT NOT NULL CHECK (base GLOB '[A-Z][A-Z][A-Z]' AND instr(CAST(base AS BLOB), x'00') = 0),
  quote TEXT NOT NULL CHECK (quote GLOB '[A-Z][A-Z][A-Z]' AND instr(CAST(quote AS BLOB), x'00') = 0),
  rate_e9 INTEGER NOT NULL
    CHECK (typeof(rate_e9) = 'integer' AND rate_e9 BETWEEN 1 AND 9007199254740991),
  as_of INTEGER NOT NULL CHECK (typeof(as_of) = 'integer'),
  PRIMARY KEY (base, quote),
  CHECK (base <> quote)
) AS FxRateRow;

-- Chart 11 (FR-WLT-05, A-20). Values signed: a computed history value is
-- never refused.
CREATE TABLE networth_snapshots (
  taken_on TEXT NOT NULL CHECK (date(taken_on) IS taken_on),
  unit TEXT NOT NULL
    CHECK ((unit GLOB '[A-Z][A-Z][A-Z]' OR (length(unit) BETWEEN 4 AND 16
      AND unit GLOB 'XAU*' AND unit NOT GLOB '*[^A-Z0-9_]*'))
      AND instr(CAST(unit AS BLOB), x'00') = 0),
  assets_minor INTEGER NOT NULL
    CHECK (typeof(assets_minor) = 'integer'
      AND assets_minor BETWEEN -9007199254740991 AND 9007199254740991),
  liabilities_minor INTEGER NOT NULL
    CHECK (typeof(liabilities_minor) = 'integer'
      AND liabilities_minor BETWEEN -9007199254740991 AND 9007199254740991),
  PRIMARY KEY (taken_on, unit)
) AS NetworthSnapshotRow;

-- Zakah per hawl lot (FR-ZAK-01/03/04). The asset FK has no cascade:
-- deleting an asset with Zakah history fails instead of deleting it.
-- lot_start_hijri is a Hijri YYYY-MM-DD (month 01–12, day 01–30), which
-- date() can't check; due_on is a Gregorian local date.
CREATE TABLE zakah_ledger (
  id TEXT NOT NULL PRIMARY KEY,
  asset_id TEXT REFERENCES assets(id),
  lot_start_hijri TEXT NOT NULL
    CHECK (instr(CAST(lot_start_hijri AS BLOB), x'00') = 0
      AND lot_start_hijri GLOB '[0-9][0-9][0-9][0-9]-[01][0-9]-[0-3][0-9]'
      AND substr(lot_start_hijri, 6, 2) BETWEEN '01' AND '12'
      AND substr(lot_start_hijri, 9, 2) BETWEEN '01' AND '30'),
  due_on TEXT NOT NULL CHECK (date(due_on) IS due_on),
  unit TEXT NOT NULL
    CHECK ((unit GLOB '[A-Z][A-Z][A-Z]' OR (length(unit) BETWEEN 4 AND 16
      AND unit GLOB 'XAU*' AND unit NOT GLOB '*[^A-Z0-9_]*'))
      AND instr(CAST(unit AS BLOB), x'00') = 0),
  amount_minor INTEGER NOT NULL
    CHECK (typeof(amount_minor) = 'integer' AND amount_minor BETWEEN 0 AND 9007199254740991),
  status TEXT NOT NULL CHECK (status IN ('pending', 'partial', 'paid')),
  paid_minor INTEGER NOT NULL DEFAULT 0
    CHECK (typeof(paid_minor) = 'integer' AND paid_minor BETWEEN 0 AND 9007199254740991),
  CHECK (paid_minor <= amount_minor),
  CHECK (CASE status
    WHEN 'pending' THEN paid_minor = 0
    WHEN 'partial' THEN paid_minor > 0 AND paid_minor < amount_minor
    ELSE paid_minor = amount_minor END)
) AS ZakahLedgerRow;

CREATE INDEX ix_zakah_asset ON zakah_ledger (asset_id) WHERE asset_id IS NOT NULL;
CREATE INDEX ix_zakah_open ON zakah_ledger (due_on) WHERE status <> 'paid';

-- §2.7 Capture controls (FR-CAP-*). Matched by institution + last-4, never
-- last-4 alone (EC-59); NULL last4 = the whole institution (FR-CAP-05).
CREATE TABLE ignore_rules (
  id TEXT NOT NULL PRIMARY KEY,
  institution_code TEXT NOT NULL
    CHECK (length(institution_code) BETWEEN 2 AND 32
      AND institution_code NOT GLOB '*[^a-z0-9_]*' AND instr(CAST(institution_code AS BLOB), x'00') = 0),
  last4 TEXT
    CHECK (last4 IS NULL OR (length(last4) BETWEEN 2 AND 4
      AND last4 NOT GLOB '*[^0-9]*' AND instr(CAST(last4 AS BLOB), x'00') = 0)),
  channel TEXT NOT NULL CHECK (channel IN ('sms', 'notification', 'apple_pay')),
  created_at INTEGER NOT NULL CHECK (typeof(created_at) = 'integer'),
  UNIQUE (institution_code, last4, channel)
) AS IgnoreRuleRow;

-- UNIQUE above treats NULL last4 as distinct: one institution-level rule
-- per channel.
CREATE UNIQUE INDEX ux_ignore_institution ON ignore_rules (institution_code, channel)
  WHERE last4 IS NULL;

-- Generic-parser senders the user chose to keep (FR-PAR-13, A-66).
CREATE TABLE capture_senders (
  sender TEXT NOT NULL PRIMARY KEY
    CHECK (length(sender) BETWEEN 1 AND 128
      AND sender NOT GLOB ('*[' || char(1) || '-' || char(31) || char(127) || '-' || char(159) || ']*')
      AND instr(CAST(sender AS BLOB), x'00') = 0),
  channel TEXT NOT NULL CHECK (channel IN ('sms', 'notification', 'shortcut_message')),
  confirmed_count INTEGER NOT NULL DEFAULT 0
    CHECK (typeof(confirmed_count) = 'integer' AND confirmed_count >= 0),
  always_capture INTEGER NOT NULL DEFAULT 0 CHECK (always_capture IN (0, 1)),
  created_at INTEGER NOT NULL CHECK (typeof(created_at) = 'integer')
) AS CaptureSenderRow;

-- FR-PAR-07 (Gold). Never uploaded; in backups.
CREATE TABLE custom_templates (
  id TEXT NOT NULL PRIMARY KEY,
  sender TEXT NOT NULL
    CHECK (length(sender) BETWEEN 1 AND 128
      AND sender NOT GLOB ('*[' || char(1) || '-' || char(31) || char(127) || '-' || char(159) || ']*')
      AND instr(CAST(sender AS BLOB), x'00') = 0),
  channel TEXT NOT NULL CHECK (channel IN ('sms', 'notification', 'shortcut_message')),
  template_json TEXT NOT NULL
    CHECK (length(CAST(template_json AS BLOB)) <= 65536
      AND instr(CAST(template_json AS BLOB), x'00') = 0
      AND CASE WHEN json_valid(template_json) THEN json_type(template_json) = 'object' ELSE 0 END),
  sample_hash TEXT NOT NULL
    CHECK (length(sample_hash) = 64 AND sample_hash NOT GLOB '*[^0-9a-f]*'
      AND instr(CAST(sample_hash AS BLOB), x'00') = 0),
  created_at INTEGER NOT NULL CHECK (typeof(created_at) = 'integer')
) AS CustomTemplateRow;

CREATE INDEX ix_templates_sender ON custom_templates (sender, channel);

CREATE TABLE review_items (
  id TEXT NOT NULL PRIMARY KEY,
  kind TEXT NOT NULL
    CHECK (kind IN ('unrecognized', 'low_confidence', 'new_sender', 'needs_category', 'transfer_ambiguous',
      'reimbursement_suggestion', 'subscription_suggestion', 'fx_pair_suggestion', 'payday_suggestion')),
  raw_message_id TEXT REFERENCES raw_messages(id) ON DELETE CASCADE,
  txn_id TEXT REFERENCES transactions(id) ON DELETE CASCADE,
  payload TEXT
    CHECK (payload IS NULL OR (length(CAST(payload AS BLOB)) <= 65536
      AND instr(CAST(payload AS BLOB), x'00') = 0
      AND CASE WHEN json_valid(payload) THEN json_type(payload) = 'object' ELSE 0 END)),
  created_at INTEGER NOT NULL CHECK (typeof(created_at) = 'integer'),
  resolved_at INTEGER CHECK (resolved_at IS NULL OR typeof(resolved_at) = 'integer'),
  resolution TEXT
    CHECK (resolution IS NULL OR (length(resolution) BETWEEN 1 AND 64
      AND resolution NOT GLOB '*[^a-z0-9_]*' AND instr(CAST(resolution AS BLOB), x'00') = 0)),
  CHECK (resolution IS NULL OR resolved_at IS NOT NULL)
) AS ReviewItemRow;

CREATE INDEX ix_review_open ON review_items (kind, created_at) WHERE resolved_at IS NULL;
CREATE INDEX ix_review_raw ON review_items (raw_message_id) WHERE raw_message_id IS NOT NULL;
CREATE INDEX ix_review_txn ON review_items (txn_id) WHERE txn_id IS NOT NULL;

-- §2.8 Preferences (typed accessors: T-020). Keys are code constants.
CREATE TABLE settings (
  "key" TEXT NOT NULL PRIMARY KEY
    CHECK (length("key") BETWEEN 1 AND 64 AND "key" NOT GLOB '*[^a-z0-9_.]*'
      AND instr(CAST("key" AS BLOB), x'00') = 0),
  value TEXT NOT NULL
    CHECK (typeof(value) = 'text' AND length(CAST(value AS BLOB)) <= 16384
      AND instr(CAST(value AS BLOB), x'00') = 0),
  updated_at INTEGER NOT NULL CHECK (typeof(updated_at) = 'integer')
) AS SettingRow;

-- Tokens and trusted-time state (security-model §3; backend-api §4.3). In
-- the encrypted DB only; never in preferences, files, logs or errors.
CREATE TABLE secure_state (
  "key" TEXT NOT NULL PRIMARY KEY
    CHECK (length("key") BETWEEN 1 AND 64 AND "key" NOT GLOB '*[^a-z0-9_.]*'
      AND instr(CAST("key" AS BLOB), x'00') = 0),
  value BLOB NOT NULL CHECK (typeof(value) = 'blob' AND length(value) BETWEEN 1 AND 65536),
  updated_at INTEGER NOT NULL CHECK (typeof(updated_at) = 'integer')
) AS SecureStateRow;

-- Queued uploads (backend-api §4.2). Turning contribution opt-in off deletes
-- the queued contributions (EC-48).
CREATE TABLE outbox (
  id TEXT NOT NULL PRIMARY KEY,
  kind TEXT NOT NULL CHECK (kind IN ('contribution', 'bank_request', 'purchase_verify')),
  payload TEXT NOT NULL
    CHECK (length(CAST(payload AS BLOB)) <= 65536
      AND instr(CAST(payload AS BLOB), x'00') = 0
      AND CASE WHEN json_valid(payload) THEN json_type(payload) = 'object' ELSE 0 END),
  created_at INTEGER NOT NULL CHECK (typeof(created_at) = 'integer'),
  attempts INTEGER NOT NULL DEFAULT 0 CHECK (typeof(attempts) = 'integer' AND attempts >= 0),
  next_attempt_at INTEGER CHECK (next_attempt_at IS NULL OR typeof(next_attempt_at) = 'integer')
) AS OutboxRow;

CREATE INDEX ix_outbox_kind ON outbox (kind, created_at);

-- Voice logs per calendar month (FR-VOI-04, A-15), 'YYYY-MM'.
CREATE TABLE voice_usage (
  month TEXT NOT NULL PRIMARY KEY
    CHECK (length(month) = 7 AND date(month || '-01') IS month || '-01'),
  "count" INTEGER NOT NULL CHECK (typeof("count") = 'integer' AND "count" >= 0)
) AS VoiceUsageRow;

-- Bulk-edit undo (FR-TXN-06, domain-algorithms §14); kept 24 h.
CREATE TABLE undo_batches (
  id TEXT NOT NULL PRIMARY KEY,
  created_at INTEGER NOT NULL CHECK (typeof(created_at) = 'integer'),
  description_key TEXT NOT NULL
    CHECK (length(description_key) BETWEEN 1 AND 64
      AND description_key NOT GLOB '*[^A-Za-z0-9_.]*' AND instr(CAST(description_key AS BLOB), x'00') = 0),
  before_json TEXT NOT NULL
    CHECK (length(CAST(before_json AS BLOB)) <= 8388608
      AND instr(CAST(before_json AS BLOB), x'00') = 0 AND json_valid(before_json))
) AS UndoBatchRow;

CREATE INDEX ix_undo_created ON undo_batches (created_at);

-- Redacted event codes only (error-handling-and-observability §3.1): the
-- code has no spaces, the fields are a small JSON object (T-021 allow-list).
CREATE TABLE diag_log (
  id INTEGER NOT NULL PRIMARY KEY,
  "at" INTEGER NOT NULL CHECK (typeof("at") = 'integer'),
  level TEXT NOT NULL CHECK (level IN ('debug', 'info', 'warn', 'error')),
  code TEXT NOT NULL
    CHECK (length(code) BETWEEN 1 AND 64 AND code NOT GLOB '*[^A-Za-z0-9_.:-]*'
      AND instr(CAST(code AS BLOB), x'00') = 0),
  fields TEXT
    CHECK (fields IS NULL OR (length(CAST(fields AS BLOB)) <= 2048
      AND instr(CAST(fields AS BLOB), x'00') = 0
      AND CASE WHEN json_valid(fields) THEN json_type(fields) = 'object' ELSE 0 END))
) AS DiagLogRow;

CREATE INDEX ix_diag_at ON diag_log ("at");
