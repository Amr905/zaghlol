-- T-018: schema v3, batch B (database-schema.md §2.4–2.5; design note in
-- docs/04-tasks/tasks/T-018.md). Merchant catalog with trigram alias search,
-- user merchant rules, budgets, fired alerts, cycle summaries and recurring
-- items. `categories` is in financial.drift (v2).
--
-- Money: integer minor units only, as in financial.drift (T-012): every
-- amount column is CHECKed to be an SQLite integer within ±(2^53 − 1) and
-- every currency column to be three uppercase ASCII letters.
--
-- Key forms (CHECKed):
-- * merchant key = the canonical `merchant_norm` of parsing-engine §5
--   (T-034): `[a-z0-9]` words separated by single spaces, 1–64 characters;
-- * category code = OpenAPI `CategoryCode`, `^[a-z][a-z0-9_]{1,31}$`;
-- * ISO dates (`cycle_start`, `due_date`, …) must be real dates:
--   `date(x) = x` (date() normalises 2026-02-30 to 2026-03-02).

import 'financial.drift';

-- §2.4 Catalog (server data, FR-SYNC-02; ops in backend-api §4.2).
CREATE TABLE catalog_merchants (
  id INTEGER NOT NULL PRIMARY KEY CHECK (id >= 1),
  canonical TEXT NOT NULL CHECK (length(canonical) BETWEEN 1 AND 200),
  name_ar TEXT,
  name_en TEXT,
  category_code TEXT NOT NULL
    CHECK (length(category_code) BETWEEN 2 AND 32 AND category_code GLOB '[a-z]*'
      AND category_code NOT GLOB '*[^a-z0-9_]*'),
  logo_key TEXT,
  version INTEGER NOT NULL CHECK (version >= 0)
) AS CatalogMerchantRow;

-- Identity is (alias_norm, merchant_id). The INTEGER PRIMARY KEY gives the
-- external-content FTS a rowid that survives VACUUM.
CREATE TABLE catalog_aliases (
  id INTEGER NOT NULL PRIMARY KEY,
  merchant_id INTEGER NOT NULL REFERENCES catalog_merchants(id) ON DELETE CASCADE,
  alias_norm TEXT NOT NULL
    CHECK (length(alias_norm) BETWEEN 1 AND 64 AND alias_norm NOT GLOB '*[^a-z0-9 ]*'
      AND alias_norm NOT GLOB ' *' AND alias_norm NOT GLOB '* ' AND alias_norm NOT GLOB '*  *'),
  "match" TEXT NOT NULL CHECK ("match" IN ('exact', 'prefix', 'token')),
  UNIQUE (alias_norm, merchant_id)
) AS CatalogAliasRow;

CREATE INDEX ix_alias_merchant ON catalog_aliases (merchant_id);

-- Fuzzy candidates (parsing-engine §5, lookup step 4).
CREATE VIRTUAL TABLE catalog_alias_fts USING fts5(
  alias_norm,
  content='catalog_aliases', content_rowid='id',
  tokenize='trigram'
);

CREATE TRIGGER trg_alias_fts_ai AFTER INSERT ON catalog_aliases
BEGIN
  INSERT INTO catalog_alias_fts ("rowid", alias_norm) VALUES (new.id, new.alias_norm);
END;

CREATE TRIGGER trg_alias_fts_ad AFTER DELETE ON catalog_aliases
BEGIN
  INSERT INTO catalog_alias_fts (catalog_alias_fts, "rowid", alias_norm)
    VALUES ('delete', old.id, old.alias_norm);
END;

CREATE TRIGGER trg_alias_fts_au AFTER UPDATE OF id, alias_norm ON catalog_aliases
BEGIN
  INSERT INTO catalog_alias_fts (catalog_alias_fts, "rowid", alias_norm)
    VALUES ('delete', old.id, old.alias_norm);
  INSERT INTO catalog_alias_fts ("rowid", alias_norm) VALUES (new.id, new.alias_norm);
END;

-- keyword_norm: folded Arabic or Latin words (backend-schema), so no
-- alphabet CHECK; no control characters, no outer or double spaces.
CREATE TABLE catalog_keywords (
  keyword_norm TEXT NOT NULL
    CHECK (length(keyword_norm) BETWEEN 1 AND 64
      AND keyword_norm NOT GLOB ('*[' || char(1) || '-' || char(31) || char(127) || '-' || char(159) || ']*')
      AND keyword_norm NOT GLOB ' *' AND keyword_norm NOT GLOB '* ' AND keyword_norm NOT GLOB '*  *'),
  lang TEXT NOT NULL CHECK (lang GLOB '[a-z][a-z]'),
  category_code TEXT NOT NULL
    CHECK (length(category_code) BETWEEN 2 AND 32 AND category_code GLOB '[a-z]*'
      AND category_code NOT GLOB '*[^a-z0-9_]*'),
  weight INTEGER NOT NULL CHECK (typeof(weight) = 'integer' AND weight BETWEEN 0 AND 100),
  PRIMARY KEY (keyword_norm, lang)
) AS CatalogKeywordRow;

CREATE TABLE catalog_meta (
  id INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
  version INTEGER NOT NULL CHECK (version >= 0),
  applied_at INTEGER NOT NULL,
  signature_kid TEXT NOT NULL CHECK (length(signature_kid) BETWEEN 1 AND 128)
) AS CatalogMetaRow;

-- FR-CAT-05/08; never uploaded. The value's form follows the kind.
CREATE TABLE merchant_rules (
  id TEXT NOT NULL PRIMARY KEY,
  match_kind TEXT NOT NULL
    CHECK (match_kind IN ('catalog_merchant', 'merchant_norm', 'counterparty')),
  match_value TEXT NOT NULL,
  category_id TEXT NOT NULL REFERENCES categories(id),
  created_at INTEGER NOT NULL,
  last_applied_at INTEGER,
  UNIQUE (match_kind, match_value),
  CHECK (match_kind <> 'merchant_norm' OR (length(match_value) BETWEEN 1 AND 64
    AND match_value NOT GLOB '*[^a-z0-9 ]*' AND match_value NOT GLOB ' *'
    AND match_value NOT GLOB '* ' AND match_value NOT GLOB '*  *')),
  CHECK (match_kind <> 'catalog_merchant' OR (length(match_value) BETWEEN 1 AND 10
    AND match_value GLOB '[1-9]*' AND match_value NOT GLOB '*[^0-9]*')),
  CHECK (match_kind <> 'counterparty' OR (length(match_value) BETWEEN 1 AND 128
    AND match_value NOT GLOB ('*[' || char(1) || '-' || char(31) || char(127) || '-' || char(159) || ']*')))
) AS MerchantRuleRow;

CREATE INDEX ix_rules_category ON merchant_rules (category_id);

-- §2.5 Budgets. One currency per budget (FR-BUD-02); category NULL = the
-- overall total (A-16), at most one per currency and period.
CREATE TABLE budgets (
  id TEXT NOT NULL PRIMARY KEY,
  category_id TEXT REFERENCES categories(id),
  currency TEXT NOT NULL CHECK (currency GLOB '[A-Z][A-Z][A-Z]'),
  limit_minor INTEGER NOT NULL
    CHECK (typeof(limit_minor) = 'integer' AND limit_minor BETWEEN 0 AND 9007199254740991),
  period TEXT NOT NULL CHECK (period IN ('cycle', 'annual')),
  rollover INTEGER NOT NULL DEFAULT 0 CHECK (rollover IN (0, 1)),
  thresholds TEXT NOT NULL DEFAULT '[80,100]'
    CHECK (CASE WHEN json_valid(thresholds) THEN json_type(thresholds) = 'array' ELSE 0 END),
  created_at INTEGER NOT NULL,
  UNIQUE (category_id, currency, period)
) AS BudgetRow;

CREATE UNIQUE INDEX ux_budgets_overall ON budgets (currency, period)
  WHERE category_id IS NULL;

-- Once per threshold per cycle (BR-BUD-02) and other once-only nudges: the
-- primary key is the "fired" fact.
CREATE TABLE fired_alerts (
  kind TEXT NOT NULL CHECK (length(kind) BETWEEN 1 AND 64 AND kind NOT GLOB '*[^a-z0-9_]*'),
  subject_id TEXT NOT NULL CHECK (length(subject_id) BETWEEN 1 AND 128),
  period_key TEXT NOT NULL CHECK (length(period_key) BETWEEN 1 AND 64),
  threshold INTEGER NOT NULL DEFAULT 0 CHECK (typeof(threshold) = 'integer' AND threshold >= 0),
  fired_at INTEGER NOT NULL,
  PRIMARY KEY (kind, subject_id, period_key, threshold)
) AS FiredAlertRow;

-- Read-model cache, rebuilt on TransactionsChanged. Amounts signed: a cache
-- never refuses a computed value.
CREATE TABLE cycle_summaries (
  cycle_start TEXT NOT NULL CHECK (date(cycle_start) IS cycle_start),
  currency TEXT NOT NULL CHECK (currency GLOB '[A-Z][A-Z][A-Z]'),
  account_filter TEXT NOT NULL DEFAULT '*' CHECK (length(account_filter) BETWEEN 1 AND 1024),
  income_minor INTEGER NOT NULL
    CHECK (typeof(income_minor) = 'integer'
      AND income_minor BETWEEN -9007199254740991 AND 9007199254740991),
  spend_minor INTEGER NOT NULL
    CHECK (typeof(spend_minor) = 'integer'
      AND spend_minor BETWEEN -9007199254740991 AND 9007199254740991),
  by_category TEXT NOT NULL CHECK (CASE WHEN json_valid(by_category) THEN json_type(by_category) = 'object' ELSE 0 END),
  computed_at INTEGER NOT NULL,
  PRIMARY KEY (cycle_start, currency, account_filter)
) AS CycleSummaryRow;

-- FR-SUB-*. amount_minor is in `currency`.
CREATE TABLE recurring_items (
  id TEXT NOT NULL PRIMARY KEY,
  kind TEXT NOT NULL CHECK (kind IN ('subscription', 'installment', 'card_due', 'gameya', 'bill')),
  status TEXT NOT NULL CHECK (status IN ('suggested', 'active', 'dismissed', 'completed')),
  name TEXT NOT NULL CHECK (length(name) BETWEEN 1 AND 60),
  merchant_norm TEXT
    CHECK (merchant_norm IS NULL OR (length(merchant_norm) BETWEEN 1 AND 64
      AND merchant_norm NOT GLOB '*[^a-z0-9 ]*' AND merchant_norm NOT GLOB ' *'
      AND merchant_norm NOT GLOB '* ' AND merchant_norm NOT GLOB '*  *')),
  account_id TEXT REFERENCES accounts(id),
  amount_minor INTEGER NOT NULL
    CHECK (typeof(amount_minor) = 'integer' AND amount_minor BETWEEN 0 AND 9007199254740991),
  currency TEXT NOT NULL CHECK (currency GLOB '[A-Z][A-Z][A-Z]'),
  cadence TEXT NOT NULL CHECK (cadence IN ('monthly', 'yearly', 'weekly', 'custom_days')),
  cadence_days INTEGER CHECK (cadence_days IS NULL OR cadence_days BETWEEN 1 AND 3660),
  due_day INTEGER CHECK (due_day IS NULL OR due_day BETWEEN 1 AND 31),
  next_due_date TEXT CHECK (next_due_date IS NULL OR date(next_due_date) IS next_due_date),
  total_count INTEGER CHECK (total_count IS NULL OR total_count >= 1),
  paid_count INTEGER NOT NULL DEFAULT 0
    CHECK (paid_count >= 0 AND (total_count IS NULL OR paid_count <= total_count)),
  reminder_days INTEGER NOT NULL DEFAULT 3 CHECK (reminder_days BETWEEN 0 AND 60),
  created_at INTEGER NOT NULL,
  CHECK ((cadence = 'custom_days') = (cadence_days IS NOT NULL))
) AS RecurringItemRow;

CREATE INDEX ix_recurring_due ON recurring_items (next_due_date) WHERE status = 'active';
CREATE INDEX ix_recurring_account ON recurring_items (account_id) WHERE account_id IS NOT NULL;

CREATE TABLE recurring_occurrences (
  item_id TEXT NOT NULL REFERENCES recurring_items(id) ON DELETE CASCADE,
  due_date TEXT NOT NULL CHECK (date(due_date) IS due_date),
  txn_id TEXT REFERENCES transactions(id) ON DELETE SET NULL,
  paid_at INTEGER,
  PRIMARY KEY (item_id, due_date)
) AS RecurringOccurrenceRow;

CREATE INDEX ix_recurring_occ_txn ON recurring_occurrences (txn_id) WHERE txn_id IS NOT NULL;

-- T-017 review m-2: a split participant that an offset link names can't move
-- to another expense (the state OFFSET_PARTICIPANT_MISMATCH prevents).
CREATE INDEX ix_offset_participant ON offset_links (participant_id)
  WHERE participant_id IS NOT NULL;

CREATE TRIGGER trg_split_participant_move BEFORE UPDATE OF expense_txn_id ON split_participants
  WHEN new.expense_txn_id IS NOT old.expense_txn_id
BEGIN
  SELECT RAISE(ABORT, 'OFFSET_PARTICIPANT_MISMATCH')
    WHERE EXISTS (SELECT 1 FROM offset_links WHERE participant_id = old.id);
END;
