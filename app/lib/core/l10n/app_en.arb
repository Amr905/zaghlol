  "privacyServerSeatKeysSummary": "iPhone only: Zaghlol can tell that earlier installs were on the same phone.",
  "@privacyServerSeatKeysSummary": {
    "description": "S · Egyptian summary · disclosure 1 (D-62); shown on iOS"
  },
  "privacyServerSeatKeys": "On iPhone, restoring or signing in sends a key proof from this install and up to four earlier ones, so the server can tell they were on the same phone. The server keeps only a scrambled form and never logs the keys.",
  "@privacyServerSeatKeys": {
    "description": "E · simple standard Arabic · disclosure 1"
  },
  "privacyServerDeleteKeepsSummary": "If you delete everything on iPhone, Gold can come back to it without using a move.",
  "@privacyServerDeleteKeepsSummary": {
    "description": "S · Egyptian summary · disclosure 2 (R4-8); shown on iOS"
  },
  "privacyServerDeleteKeeps": "\"Delete everything\" on iPhone keeps the identity keys on the phone, so Gold can return without counting as a move. The server keeps a keyed hash of the key with the purchase until the purchase is deleted. Erasing the iPhone removes them.",
  "@privacyServerDeleteKeeps": {
    "description": "E · simple standard Arabic · disclosure 2"
  },
  "privacyServerTimeNonceSummary": "A random number the server uses to check the time. It says nothing about you.",
  "@privacyServerTimeNonceSummary": {
    "description": "S · Egyptian summary · disclosure 3 (R4-2)"
  },
  "privacyServerTimeNonce": "Some requests carry a random one-time number used to check the time. It contains nothing about the phone or the user, and it isn't stored.",
  "@privacyServerTimeNonce": {
    "description": "E · simple standard Arabic · disclosure 3"
  },
  "privacyServerSupportNoticeSummary": "If support links your Gold to an account, the phone you bought it on is told.",
  "@privacyServerSupportNoticeSummary": {
    "description": "S · Egyptian summary · disclosure 4 (R4-7(2), R5-7)"
  },
  "privacyServerSupportNotice": "If support links Gold to an account, the phone that bought it is told when it next connects. The server repeats the notice until that phone's next sync confirms it, so a lost response doesn't lose it.",
  "@privacyServerSupportNotice": {
    "description": "E · simple standard Arabic · disclosure 4"
  },
  "privacyServerSupportRowsSummary": "When you delete your account we delete everything, and support traces go after a year.",
  "@privacyServerSupportRowsSummary": {
    "description": "S · Egyptian summary · D-47, FR-ACCT-04"
  },
  "privacyServerSupportRows": "When an account is deleted its data is removed from the server, except support audit rows that hold an encrypted e-mail fingerprint and the account ID. They are deleted automatically one year after creation.",
  "@privacyServerSupportRows": {
    "description": "E · simple standard Arabic"
  },
