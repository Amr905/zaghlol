{
  "sourceLanguage": "en",
  "strings": {
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "زغلول بيستخدم الكاميرا عشان تصوّر الفاتورة ويقراها على موبايلك. الصورة بتتمسح بعد ما تتقرأ ومبتتحفظش في صورك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaghlol uses the camera to photograph a receipt and read it on your phone. The photo is deleted after reading and is not saved to your photos."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "زغلول بيسمعك عشان تقوله صرفت إيه. مبنحتفظش بتسجيل لصوتك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaghlol listens so you can tell it what you spent. It does not keep a recording of your voice."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "زغلول بيحوّل كلامك لنص على موبايلك عشان يسجل المصاريف. لو الموبايل مبيفهمش عربي من غير نت، مش هنبعت صوتك لحد إلا لما توافق."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaghlol turns your speech into text on your phone to log expenses. If your phone cannot do Arabic offline, your voice is sent to Apple's speech service only if you agree."
          }
        }
      }
    }
  },
  "version": "1.0"
}
