    "native_ios_intentDialogNotBank": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دي مش رسالة بنك، فزغلول سابها."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That's not a bank message, so Zaghlol skipped it."
          }
        }
      }
    },
    "native_ios_intentDialogNotSaved": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "زغلول مقدرش يحفظها دلوقتي."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaghlol couldn't save it right now."
          }
        }
      }
    },
    "native_ios_intentDialogSaved": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "زغلول سجلها ✓"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaghlol logged it ✓"
          }
        }
      }
    },
    "native_ios_intentDialogSavedForLater": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "زغلول حفظها، وهيسجلها أول ما تفتح التطبيق."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaghlol saved it and will log it when you open the app."
          }
        }
      }
    },
    "native_ios_intentLogMessageDesc": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بيدّي نص رسالة البنك لزغلول على الموبايل ده عشان يسجل الحركة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hands a bank message to Zaghlol on this phone so it can log it."
          }
        }
      }
    },
    "native_ios_intentLogMessageShort": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رسالة بنك"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank message"
          }
        }
      }
    },
