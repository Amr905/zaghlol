      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل رسالة بنك في زغلول"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log bank message in Zaghlol"
          }
        }
      }
    },
