<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- T-008 (SPK-01) SMS ingestion spike, reduced by T-041 to the receiver
         and the latency recorder, and by T-040 to the latency recorder only:
         the SMS receiver is the production one (src/sms, every *Sms build).
         This source set is the dev x sms flavour combination only: no
         staging*/prod* build contains spike code or the spike Guard base
         (assets/guard/spike_guard_base.json). CI checks the merged manifests
         and dex of every flavour. -->
    <application>
        <!-- Installs the spike latency recorder as the production IngestTrace
             (T-041). Merged into the androidx.startup provider WorkManager
             declares; not exported. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="app.zaghlol.spike.sms.SpikeInitializer"
                android:value="androidx.startup" />
        </provider>
    </application>
</manifest>
