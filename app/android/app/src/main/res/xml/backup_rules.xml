<?xml version="1.0" encoding="utf-8"?>
<!-- FR-SEC-05 / T-165 (API 26-30): ignored while allowBackup="false"; kept as
     defense in depth so a merged manifest that flips allowBackup still backs
     up nothing. Never add an <include>. CI asserts exactly these 9 excludes. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
    <exclude domain="device_root" path="." />
    <exclude domain="device_file" path="." />
    <exclude domain="device_database" path="." />
    <exclude domain="device_sharedpref" path="." />
</full-backup-content>
