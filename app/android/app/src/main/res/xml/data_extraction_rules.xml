<?xml version="1.0" encoding="utf-8"?>
<!-- FR-SEC-05 / T-165 (API 31+): exclude every domain from cloud backup AND
     device-to-device transfer. allowBackup="false" does not stop D2D on
     API 31+; only <device-transfer> does. Never add an <include>.
     CI asserts both sections hold exactly these 9 excludes with path=".". -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
    </device-transfer>
</data-extraction-rules>
