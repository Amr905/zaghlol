<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- T-141 (T-001 review F16): BackendClient talks to the Zaghlol backend
         (catalog, flags, prices, purchase verification). Financial data
         never goes there (BR-SYNC-03). -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- NOTIF-GW (FR-NTF): local alerts on Android 13+. Requested at runtime
         after onboarding or when the user first turns an alert type on;
         never at install. Local notifications only: no FCM, no
         RECEIVE_BOOT_COMPLETED, no SCHEDULE_EXACT_ALARM. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- FR-SEC-05 / T-165: no OS mechanism may copy app data off the phone.
         allowBackup=false stops Auto Backup, key/value backup and adb backup
         (API 26-30) and cloud backup (API 31+). On API 31+ only
         dataExtractionRules <device-transfer> stops device-to-device transfer,
         so both rule files exclude every domain. fullBackupContent is defense
         in depth if a merged manifest ever flips allowBackup.
         hasFragileUserData=false: never offer "keep app data" on uninstall
         (the Keystore key is deleted, leaving an unreadable DB).
         CI (app-ci.yml) asserts all of this on every final APK.
         T-178: networkSecurityConfig trusts system CAs only in release
         builds (user CAs in debug-overrides only; ADR-012 Part B (d)). -->
    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:hasFragileUserData="false"
        android:networkSecurityConfig="@xml/network_security_config">
        <!-- NOTIF-GW: fires a delayed (quiet hours) alert. Not exported; reached
             only through the app's own explicit PendingIntent. -->
        <receiver
            android:name=".platform.notifications.NotificationAlarmReceiver"
            android:exported="false"/>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- T-024: zaghlol://add, review, home, voice, budget, bills
                 (notifications and widgets). Custom scheme only; the app
                 maps unknown targets to Home and never logs the link. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="zaghlol"/>
            </intent-filter>
        </activity>
        <!-- T-118 / FR-WID-01: the safe-to-spend home-screen widget (Glance).
             Exported because the launcher / system bind widget providers; it
             accepts only the system's APPWIDGET_UPDATE, holds no permission
             and reads nothing but the app's own encrypted, already redacted
             snapshot in noBackupFilesDir/widget (never backed up). -->
        <receiver
            android:name=".platform.widget.SafeToSpendWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/safe_to_spend_widget_info"/>
        </receiver>
        <!-- T-060 / FR-ING-A-04: share-to-Zaghlol target. Exported because other
             apps must be able to start it; it accepts only ACTION_SEND with
             the four declared MIME types, has no UI, requests no permission
             (the sender grants read access to the shared content:// URI) and
             re-validates type, size and URI scheme itself. See
             platform/share/ShareActivity.kt. No noHistory: leaving the
             activity mid-copy must not finish it (the read grant is tied to
             it); it finishes itself within the intake deadline (T-060 F3). -->
        <activity
            android:name=".platform.share.ShareActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
                <data android:mimeType="image/*"/>
                <data android:mimeType="application/pdf"/>
                <data android:mimeType="text/csv"/>
            </intent-filter>
        </activity>
        <!-- T-041: WorkManager (the ingestion worker, every flavour) merges
             SystemJobService (exported, BIND_JOB_SERVICE: only the system can
             bind), SystemForegroundService (not exported, no
             foregroundServiceType: the app never calls setForeground; API
             26-30 expedited fallback only), two non-exported receivers, and
             WAKE_LOCK / ACCESS_NETWORK_STATE / RECEIVE_BOOT_COMPLETED /
             FOREGROUND_SERVICE. Its DiagnosticsReceiver is exported (guarded
             by DUMP) and dumps work specs to logcat on request: removed.
             CI (apk-perms) asserts it is absent, and that no
             FOREGROUND_SERVICE_* type permission is merged. -->
        <receiver
            android:name="androidx.work.impl.diagnostics.DiagnosticsReceiver"
            tools:node="remove" />
        <!-- T-043 / FR-ING-A-03/07: bank-notification listener, every flavour.
             Exported because the system binds it; the BIND_NOTIFICATION_LISTENER_SERVICE
             permission lets only the system do so. Not directBootAware (the
             spool key needs the unlocked user). No android:label (the system
             shows the app name). The meta-data keep ongoing notifications from
             being delivered at all (API 31+; older APIs rely on the flag check
             in the listener). Access itself is user-granted in system settings
             (T-044); the app declares no permission for it. -->
        <service
            android:name=".platform.capture.BankNotificationListener"
            android:exported="true"
            android:directBootAware="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService"/>
            </intent-filter>
            <meta-data
                android:name="android.service.notification.default_filter_types"
                android:value="conversations|alerting|silent"/>
            <meta-data
                android:name="android.service.notification.disabled_filter_types"
                android:value="ongoing"/>
        </service>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
