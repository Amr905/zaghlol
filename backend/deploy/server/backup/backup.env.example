# /etc/zaghlol/backup.env  (owner root, mode 0600). Read by backup.sh and restore.sh. Placeholders only.
# Compose project folder and env file (defaults shown).
COMPOSE_DIR=/opt/zaghlol/deploy/server
PRODUCTION_ENV=/etc/zaghlol/production.env
# Local backup root (host path, owner root 0700 except wal/, which postgres writes as uid 999).
BACKUP_ROOT=/var/lib/zaghlol/backup
# Retention: base backups and dumps kept for this many days; WAL one day longer, so every kept base backup can reach any
# point in the last 14 days.
RETENTION_DAYS=15
# Off-server copy over ssh (rsync). Empty = no off-server copy (not recommended; the alert below still fires on failure).
OFFSITE_TARGET=backup@backup.example.com:/srv/backups/zaghlol
# Private key used for the off-server target, and its pinned host key line (ssh-keyscan once, check the fingerprint by hand).
OFFSITE_SSH_KEY=/etc/zaghlol/backup/id_ed25519
OFFSITE_KNOWN_HOSTS=/etc/zaghlol/backup/known_hosts
# E-mail for failure notices (needs a working `mail` command on the host); empty = journal only.
ALERT_EMAIL=
