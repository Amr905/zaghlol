# /etc/zaghlol/app.env  (owner root, mode 0600). Application settings for api and worker (deployment.md section 3 lists the
# settings the processes refuse to start without). No database password here: connection strings are built by the compose file.
# Placeholders only. Multi-line secrets go in double quotes with \n for line breaks. The App Store and Play secrets can't be
# checked at deploy time: a wrong value stops the process at start and the log names the key, never the value.

# --- Forwarded headers (T-124): the hop in front of the api is Caddy, on the compose network 172.30.52.0/24 ---
ForwardedHeaders__KnownNetworks__0=172.30.52.0/24

# --- Key custody: File KMS (T-200). Replace with the OpenBao settings when moving (deployment.md, ADR-023) ---
Kms__Provider=File
Kms__File__KeyDirectory=/run/zaghlol-kms
# Print these with the key tool (deployment.md "Creating the keys"); one fingerprint (64 hex) per key:
Kms__File__Fingerprints__s2026a=<64 hex>
Kms__File__Fingerprints__e2026a=<64 hex>
Kms__File__Fingerprints__seat=<64 hex>
Kms__File__Fingerprints__audit=<64 hex>
Kms__File__Fingerprints__install_pepper=<64 hex>
Kms__File__Fingerprints__envelope=<64 hex>
# Only while no staging exists; otherwise list the other environment's fingerprints as Kms__File__OtherEnvironmentFingerprints__0..
Kms__File__NoOtherEnvironment=true
Kms__HmacKeys__Seat=file:seat
Kms__HmacKeys__Audit=file:audit
Kms__HmacKeys__InstallHashPepper=file:install-pepper
Kms__HmacKeys__SeatCheck=<64 hex printed by the key tool>
Kms__Envelope__KeyRef=file:envelope
# Signing ring: one Active key per purpose. Values from the key tool output.
Signing__Keys__0__Kid=s2026a
Signing__Keys__0__Purpose=Sync
Signing__Keys__0__Status=Active
Signing__Keys__0__KeyRef=file:s2026a
Signing__Keys__0__PublicJwk__Kty=EC
Signing__Keys__0__PublicJwk__Crv=P-256
Signing__Keys__0__PublicJwk__X=<base64url x>
Signing__Keys__0__PublicJwk__Y=<base64url y>
Signing__Keys__1__Kid=e2026a
Signing__Keys__1__Purpose=Entitlement
Signing__Keys__1__Status=Active
Signing__Keys__1__KeyRef=file:e2026a
Signing__Keys__1__PublicJwk__Kty=EC
Signing__Keys__1__PublicJwk__Crv=P-256
Signing__Keys__1__PublicJwk__X=<base64url x>
Signing__Keys__1__PublicJwk__Y=<base64url y>

# --- Catalog snapshots: the directory is set by the compose file; this is the public origin (the API endpoint URL base) ---
Catalog__Snapshots__BaseUrl=https://api.example.com

# --- Google Play (T-130, T-133) ---
Purchases__Google__PackageName=<play package name>
Purchases__Google__CredentialSource=ServiceAccountJson
# Service-account JSON on ONE line (or ApplicationDefault is not available on a plain server).
Purchases__Google__Credential=<service account json>
Purchases__Google__Products__zaghlol_gold_monthly__Kind=subscription
Purchases__Google__Products__zaghlol_gold_monthly__Plan=monthly
Purchases__Google__Products__zaghlol_gold_yearly__Kind=subscription
Purchases__Google__Products__zaghlol_gold_yearly__Plan=yearly
Purchases__Google__Products__zaghlol_gold_lifetime__Kind=onetime
Purchases__Google__Products__zaghlol_gold_lifetime__Plan=lifetime
# Equal to API_REPLICAS in production.env.
Purchases__Google__Budget__Replicas=2
# Real-time developer notifications (push subscription audience and its service account e-mail).
Rtdn__Audience=https://api.example.com/v1/notifications/google
Rtdn__PushServiceAccount=<push service account e-mail>

# --- App Store (T-131, T-134) ---
Purchases__Apple__BundleId=<ios bundle id>
Purchases__Apple__Products__zaghlol_gold_monthly__Type=auto_renewable
Purchases__Apple__Products__zaghlol_gold_monthly__Plan=monthly
Purchases__Apple__Products__zaghlol_gold_yearly__Type=auto_renewable
Purchases__Apple__Products__zaghlol_gold_yearly__Plan=yearly
Purchases__Apple__Products__zaghlol_gold_lifetime__Type=non_consumable
Purchases__Apple__Products__zaghlol_gold_lifetime__Plan=lifetime
Purchases__Apple__AllowSandbox=true
Purchases__Apple__IssuerId=<issuer id>
Purchases__Apple__KeyId=<key id>
# The .p8 file's PEM text on one line, newlines written as \n (PKCS#8 EC P-256).
Purchases__Apple__PrivateKey=<contents of the .p8 file>
Purchases__Apple__Budget__Replicas=2

# --- Sign in with Apple / Google (T-135, optional sign-in) ---
Accounts__Apple__ServicesId=<services id>
Accounts__Apple__BundleId=<ios bundle id>
Accounts__Apple__TeamId=<team id>
Accounts__Apple__KeyId=<key id>
# The .p8 file's PEM text on one line, newlines written as \n (PKCS#8 EC P-256).
Accounts__Apple__PrivateKey=<contents of the .p8 file>
Accounts__Google__ClientIds__0=<google oauth client id>

# --- Restore attestation (T-181) ---
Attestation__AppAttest__TeamId=<10-character team id>
Attestation__AppAttest__AllowDevelopmentEnvironment=false

# --- Operator sign-in (T-136): OIDC + MFA, public values (setup per IdP in operator-idp-setup.md) ---
OperatorAuth__Enabled=true
OperatorAuth__Profile=Google
OperatorAuth__Issuer=https://accounts.google.com
OperatorAuth__Audiences__0=<zaghlol-ops client id>
OperatorAuth__AllowedDomains__0=<workspace domain>

# --- Gold/FX prices (T-127) ---
Prices__Providers=goldapi
Prices__GoldApi__ApiKey=<goldapi key>

# --- Optional ---
# OpsChannel__WebhookUrl=https://hooks.example.com/<incoming webhook, a credential>

# --- LLM providers (T-338, ask-llm.md section 3). Model ids, endpoints and prices are configuration, never code; the keys are NOT here
# (they come from the KMS secret store, deployment.md "LLM provider keys"). Prices: USD per million tokens, decimals. Uncomment the
# providers to offer; Llm__ActiveProvider (or remote config llm.provider) names the one in use.
#Llm__Providers__gemini-flash-lite__Kind=VertexGemini
#Llm__Providers__gemini-flash-lite__Model=<Vertex model id, e.g. gemini-3.1-flash-lite>
#Llm__Providers__gemini-flash-lite__Endpoint=https://europe-west4-aiplatform.googleapis.com/
#Llm__Providers__gemini-flash-lite__Region=europe-west4
#Llm__Providers__gemini-flash-lite__Project=<Google Cloud project id>
#Llm__Providers__gemini-flash-lite__PriceInPerMTok=0.25
#Llm__Providers__gemini-flash-lite__PriceCachedPerMTok=0.025
#Llm__Providers__gemini-flash-lite__PriceOutPerMTok=1.50
#Llm__Providers__claude-haiku__Kind=AnthropicMessages
#Llm__Providers__claude-haiku__Model=<Anthropic model id, e.g. claude-haiku-5-5>
#Llm__Providers__claude-haiku__Endpoint=https://api.anthropic.com/
#Llm__Providers__claude-haiku__PriceInPerMTok=<USD per million input tokens>
#Llm__Providers__claude-haiku__PriceCachedPerMTok=<USD per million cache-read tokens>
#Llm__Providers__claude-haiku__PriceOutPerMTok=<USD per million output tokens>
