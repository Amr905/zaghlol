{
  "uid": "zaghlol-purchases",
  "title": "Zaghlol: purchases, entitlements and seats",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": [
    "zaghlol"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Purchase verifications by outcome and code",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome, code) (rate(zaghlol_purchase_verify_total[15m]))",
          "legendFormat": "{{outcome}} {{code}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Unacknowledged purchases",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(zaghlol_purchase_unacked)",
          "legendFormat": "count"
        },
        {
          "refId": "B",
          "expr": "max(zaghlol_purchase_unacked_oldest_age_seconds)",
          "legendFormat": "oldest age (s)"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Time to acknowledge (p95)",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(zaghlol_purchase_time_to_ack_seconds_bucket[1h])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Store notification lag (p95)",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(zaghlol_notification_processing_lag_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Notifications ingested and dead-lettered",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (store) (rate(zaghlol_notification_ingested_total[15m]))",
          "legendFormat": "ingested {{store}}"
        },
        {
          "refId": "B",
          "expr": "sum by (store) (increase(zaghlol_notification_dead_letter_total[1h]))",
          "legendFormat": "dead-lettered {{store}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Seat changes by channel and kind",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (channel, kind) (increase(zaghlol_seat_change_total[1h]))",
          "legendFormat": "{{channel}} {{kind}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "MOVE_COOLDOWN refusals by channel",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (channel) (increase(zaghlol_seat_move_cooldown_refused_total[1h]))",
          "legendFormat": "{{channel}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Support actions by outcome",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (action, outcome, ownership_outcome) (increase(zaghlol_support_action_total[1d]))",
          "legendFormat": "{{action}} {{outcome}} {{ownership_outcome}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Attestation failures by platform and reason",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (platform, reason) (increase(zaghlol_attestation_failure_total[1h]))",
          "legendFormat": "{{platform}} {{reason}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Play Integrity usage vs quota",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(zaghlol_play_integrity_calls_total[1d]))",
          "legendFormat": "calls (24h)"
        },
        {
          "refId": "B",
          "expr": "max(zaghlol_play_integrity_daily_quota)",
          "legendFormat": "daily quota"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Audit alerts fired by rule",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (rule) (increase(zaghlol_audit_alert_fired_total[1d]))",
          "legendFormat": "{{rule}}"
        }
      ]
    }
  ]
}
