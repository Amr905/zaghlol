<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\Zaghlol.Api\Zaghlol.Api.csproj" />
    <ProjectReference Include="..\..\src\Zaghlol.Domain\Zaghlol.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="YamlDotNet" />
    <!-- T-124 FU-011: the install endpoints' live contract tests run against a real PostgreSQL. -->
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="WireMock.Net.Minimal" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\FakeKms.cs" Link="Shared\FakeKms.cs" />
    <Compile Include="..\Shared\PlayWireMock.cs" Link="Shared\PlayWireMock.cs" />
    <Compile Include="..\Shared\AppleTestPki.cs" Link="Shared\AppleTestPki.cs" />
    <Compile Include="..\Shared\AppleWireMock.cs" Link="Shared\AppleWireMock.cs" />
    <Compile Include="..\Shared\ZaghlolTestDatabase.cs" Link="Shared\ZaghlolTestDatabase.cs" />
    <Compile Include="..\Shared\SeatKeyTestSigner.cs" Link="Shared\SeatKeyTestSigner.cs" />
    <Compile Include="..\Shared\FakeAttestation.cs" Link="Shared\FakeAttestation.cs" />
    <None Include="..\..\deploy\db\bootstrap-roles.sql" Link="db\bootstrap-roles.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- T-138: alert rules, synthetics and dashboards as code, linted by the Observability tests. -->
    <Content Include="..\..\deploy\observability\**\*" Link="observability\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The spec under test is copied next to the test assembly. -->
    <Content Include="..\..\openapi\zaghlol-v1.yaml" Link="openapi\zaghlol-v1.yaml" CopyToOutputDirectory="PreserveNewest" />
    <!-- Shared install-bound restore hash vectors (backend-api.md section 4.3), also used by the Dart tests. -->
    <None Update="vectors\restore-binding-v1.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Shared iOS seat-key proof vectors (D-55, backend-api.md section 4.3). -->
    <None Update="vectors\seat-proof-v1.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- T-182 K_seat keyed-hash vectors (synthetic key 00..1f) and the pinned Wycheproof P-256 P1363 file (Apache-2.0, see NOTICE.txt). -->
    <None Update="vectors\seat-key-hash-v1.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="vectors\wycheproof\ecdsa_secp256r1_sha256_p1363_test.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- T-130 store binding (Play obfuscatedAccountId / Apple appAccountToken); also read by the Dart tests (T-145) and T-131. -->
    <None Update="vectors\store-binding-v1.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- T-123 shared signing vectors (public test keys only; also read by the Dart verifier) and RFC 4231 HMAC cases. -->
    <None Update="vectors\response-signature-v1.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="vectors\jws-es256-v1.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="vectors\keyed-hash-v1.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- T-125 catalog snapshot vector (public test key only; also read by the Dart verifier). -->
    <None Update="vectors\catalog-snapshot-v1.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
