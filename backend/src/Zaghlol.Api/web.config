<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS hosting profile for MonsterASP.NET (T-206, D-80). Committed TEMPLATE: it holds no secrets and no connection strings.
  The deploy workflow (backend-deploy-monsterasp.yml) adds the secret settings to <environmentVariables> on the runner, from the
  `backend-production` environment secret, with deploy/monsterasp/monsterasp_package.py render. Never edit the live file by hand
  in a way that is committed back.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- In-process: one w3wp.exe, so the embedded worker jobs share the API's lifetime. stdout logging stays off: the app logs
           structured, redacted JSON through Serilog; a stdout file would collect anything written by the runtime. -->
      <aspNetCore processPath="dotnet" arguments=".\Zaghlol.Api.dll" stdoutLogEnabled="false" hostingModel="inprocess">
        <environmentVariables>
          <!-- Non-secret defaults only. Secret and site-specific settings are injected at deploy time. -->
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <environmentVariable name="Hosting__EmbeddedWorkers" value="true" />
          <environmentVariable name="ForwardedHeaders__NoProxy" value="true" />
          <environmentVariable name="DOTNET_EnableDiagnostics" value="0" />
        </environmentVariables>
      </aspNetCore>
      <security>
        <requestFiltering removeServerHeader="true">
          <!-- The largest accepted body is a 64 KiB JSON document (StrictJson.MaxBodyBytes); 128 KiB leaves headroom. -->
          <requestLimits maxAllowedContentLength="131072" maxUrl="2048" maxQueryString="1024" />
          <!-- Never serve the catalog snapshots or anything else under App_Data as static content. -->
          <hiddenSegments>
            <add segment="App_Data" />
          </hiddenSegments>
        </requestFiltering>
      </security>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
