<?xml version="1.0" encoding="utf-8"?>
<!-- Package-only profile for MonsterASP.NET (T-206): framework-dependent win-x64, in-process. It names no host, user or password;
     the deploy workflow supplies those to msdeploy from environment secrets. Use: dotnet publish -p:PublishProfile=MonsterAsp -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
    <PublishDir>bin\publish\monsterasp\</PublishDir>
    <PublishSingleFile>false</PublishSingleFile>
    <DebugType>none</DebugType>
    <DeleteExistingFiles>false</DeleteExistingFiles>
  </PropertyGroup>
</Project>
