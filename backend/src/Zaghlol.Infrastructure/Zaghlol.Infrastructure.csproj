<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Zaghlol.Application\Zaghlol.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <!-- Design-time only (dotnet ef); not shipped with the API or worker. -->
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Google.Apis.Auth" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="Serilog.Formatting.Compact" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="System.Formats.Cbor" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Zaghlol.Infrastructure.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- T-131: Apple Root CA - G3 (DER), the only trust anchor of the Apple JWS verifier. Its SHA-256 is asserted at startup. -->
    <EmbeddedResource Include="AppStore\AppleRootCA-G3.cer" LogicalName="Zaghlol.AppStore.AppleRootCA-G3.cer" />
    <!-- T-181: Apple App Attestation Root CA (DER), the only trust anchor of the App Attest verifier. Its SHA-256 is asserted on load. -->
    <EmbeddedResource Include="Attestation\AppleAppAttestationRootCA.cer" LogicalName="Zaghlol.Attestation.AppleAppAttestationRootCA.cer" />
  </ItemGroup>

</Project>
