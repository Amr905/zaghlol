root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{csproj,props,targets,json,yml,yaml,config}]
indent_size = 2

[*.cs]
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:warning
csharp_style_namespace_declarations = file_scoped:warning
csharp_new_line_before_open_brace = all

# Test method and class names may be descriptive.
[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
# Tests build SQL from constants and synthetic fixtures only (schema assertions, negative CHECK cases).
dotnet_diagnostic.CA2100.severity = none

# EF Core migrations, designer files and the model snapshot are generated by `dotnet ef` (backend-ef-migration
# workflow); analyzers and `dotnet format` treat them as generated code. Hand-written SQL lives in InitialCreateSql.cs.
[src/Zaghlol.Infrastructure/Persistence/Migrations/*.cs]
generated_code = true

# Persistence entities map bytea / arrays to byte[] / T[] by design (EF Core value semantics for those columns).
[src/Zaghlol.Infrastructure/Persistence/Entities/*.cs]
dotnet_diagnostic.CA1819.severity = none
