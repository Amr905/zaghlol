{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zaghlol.app/contracts/ask-plan-v1.schema.json",
  "$comment": "ask-plan/1. Source of truth for the Ask Zaghlol plan contract (docs/03-technical/ask-llm.md section 2). Validation order (section 2.4): step 1 is this schema; steps 2-6 are rules this file cannot express (refs and plain names, mention substring, amount rule, cross-field rules, template grammar) and are fixed by backend/tests/Zaghlol.Contract.Tests/vectors/ask-plan-v1.json. STEP 5 INCLUDES: p must validate against $defs/P_<plan> for the named plan (anyOf alone cannot tie plan to p). PROVIDER KEYWORD SUBSET: only type (incl. [T,'null']), properties, required, additionalProperties:false, enum (a single-value enum instead of const), anyOf (nullable objects and the p union only), $defs/$ref, pattern, minimum, maximum, minItems, maxItems are used. Not used: oneOf, allOf, not, if/then/else, const, uniqueItems, minLength, maxLength, format, patternProperties, dependent*. Root is an object (OpenAI strict forbids a root anyOf); at most 5 nested object levels (limit 10); 56 properties counting each $def once, far below 5000 with every $ref expanded; 16 slug enum values (limit 1000). EXCEPTIONS AND ADAPTER WORKAROUNDS: (1) $schema, $id and this $comment are stripped from the copy sent to a provider. (2) Anthropic structured output ignores minimum, maximum, minItems and maxItems, and limits parameters that use anyOf or type arrays (16 per request); this schema exceeds that budget, and Anthropic is not a launch provider (ADR-027). An Anthropic adapter would send the schema with the numeric bounds moved into descriptions and rely on our own validation (step 1 runs on every reply anyway). (3) Gemini responseJsonSchema documents no pattern keyword: the adapter keeps pattern (ignored if unsupported); step 1 enforces it server side. (4) OpenAI does not document minLength/maxLength, so the mention length and no-digit rule (1..40, no digit) is a pattern with a bounded repeat, re-checked in step 3. Template lang and text carry no schema constraint on purpose: a bad template must drop only t (step 6), not the whole plan, so lang, length, NFC, one-line and the grammar are all step 6. (5) The slug enum equals the 16 system category codes of the bundled catalog at release time; a new system category means a new schema copy (ask-plan/1 stays valid for older phones). Digits: amount strings are ASCII digits only (the phone normalises Arabic-Indic digits before sending, and the model is told to emit ASCII).",
  "title": "ask-plan/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "plan",
    "p",
    "t"
  ],
  "properties": {
    "v": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "plan": {
      "type": "string",
      "enum": [
        "PL-SPEND",
        "PL-COMPARE",
        "PL-BREAKDOWN",
        "PL-TOPN",
        "PL-AVERAGE",
        "PL-INCOME",
        "PL-SAVED",
        "PL-BILLS-DUE",
        "PL-BUDGET-LEFT",
        "PL-SAFE-SPEND",
        "PL-BALANCE",
        "PL-WHATIF-CUT",
        "PL-WHATIF-SAVE",
        "PL-SUGGEST",
        "PL-INVEST",
        "PL-FALLBACK",
        "PL-REFUSE"
      ]
    },
    "p": {
      "anyOf": [
        {
          "$ref": "#/$defs/P_PL-SPEND"
        },
        {
          "$ref": "#/$defs/P_PL-COMPARE"
        },
        {
          "$ref": "#/$defs/P_PL-BREAKDOWN"
        },
        {
          "$ref": "#/$defs/P_PL-TOPN"
        },
        {
          "$ref": "#/$defs/P_PL-AVERAGE"
        },
        {
          "$ref": "#/$defs/P_PL-INCOME"
        },
        {
          "$ref": "#/$defs/P_PL-SAVED"
        },
        {
          "$ref": "#/$defs/P_PL-BILLS-DUE"
        },
        {
          "$ref": "#/$defs/P_PL-BUDGET-LEFT"
        },
        {
          "$ref": "#/$defs/P_PL-SAFE-SPEND"
        },
        {
          "$ref": "#/$defs/P_PL-BALANCE"
        },
        {
          "$ref": "#/$defs/P_PL-WHATIF-CUT"
        },
        {
          "$ref": "#/$defs/P_PL-WHATIF-SAVE"
        },
        {
          "$ref": "#/$defs/P_PL-SUGGEST"
        },
        {
          "$ref": "#/$defs/P_PL-FALLBACK"
        },
        {
          "$ref": "#/$defs/P_PL-REFUSE"
        },
        {
          "$ref": "#/$defs/P_PL-INVEST"
        }
      ]
    },
    "t": {
      "anyOf": [
        {
          "$ref": "#/$defs/Template"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "CategorySlug": {
      "type": "string",
      "enum": [
        "groceries",
        "dining",
        "transport",
        "bills",
        "housing",
        "shopping",
        "debt",
        "subscriptions",
        "health",
        "education",
        "entertainment",
        "family_giving",
        "savings",
        "income",
        "cash",
        "instapay"
      ]
    },
    "Period": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "k",
        "o",
        "n",
        "m",
        "y"
      ],
      "properties": {
        "k": {
          "type": "string",
          "enum": [
            "day",
            "week",
            "month",
            "year",
            "cycle",
            "lastDays",
            "monthOfYear",
            "allTime"
          ]
        },
        "o": {
          "type": "integer",
          "minimum": -36,
          "maximum": 0
        },
        "n": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 366
        },
        "m": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 12
        },
        "y": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 2000,
          "maximum": 2100
        }
      }
    },
    "Filter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "ref",
        "mention",
        "currency"
      ],
      "properties": {
        "slug": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "groceries",
            "dining",
            "transport",
            "bills",
            "housing",
            "shopping",
            "debt",
            "subscriptions",
            "health",
            "education",
            "entertainment",
            "family_giving",
            "savings",
            "income",
            "cash",
            "instapay",
            null
          ]
        },
        "ref": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^⟦(ACCOUNT|CARD|BANK|MERCHANT)_[1-9]⟧$"
        },
        "mention": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[^0-9٠-٩۰-۹]{1,40}$"
        },
        "currency": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{3}$"
        }
      }
    },
    "Amount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "currency"
      ],
      "properties": {
        "amount": {
          "type": "string",
          "pattern": "^[0-9]{1,9}(\\.[0-9]{1,3})?$"
        },
        "currency": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{3}$"
        }
      }
    },
    "Template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lang",
        "text"
      ],
      "properties": {
        "lang": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "Mode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "percent",
        "amount",
        "currency"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "percent",
            "amount"
          ]
        },
        "percent": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 100
        },
        "amount": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{1,9}(\\.[0-9]{1,3})?$"
        },
        "currency": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{3}$"
        }
      }
    },
    "P_PL-SPEND": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "period",
        "filter"
      ],
      "properties": {
        "period": {
          "$ref": "#/$defs/Period"
        },
        "filter": {
          "$ref": "#/$defs/Filter"
        }
      }
    },
    "P_PL-COMPARE": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "periodA",
        "periodB",
        "filter"
      ],
      "properties": {
        "periodA": {
          "$ref": "#/$defs/Period"
        },
        "periodB": {
          "$ref": "#/$defs/Period"
        },
        "filter": {
          "$ref": "#/$defs/Filter"
        }
      }
    },
    "P_PL-BREAKDOWN": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "period",
        "by",
        "limit"
      ],
      "properties": {
        "period": {
          "$ref": "#/$defs/Period"
        },
        "by": {
          "type": "string",
          "enum": [
            "category",
            "merchant",
            "account"
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      }
    },
    "P_PL-TOPN": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "period",
        "of",
        "n"
      ],
      "properties": {
        "period": {
          "$ref": "#/$defs/Period"
        },
        "of": {
          "type": "string",
          "enum": [
            "merchant",
            "category",
            "expense"
          ]
        },
        "n": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      }
    },
    "P_PL-AVERAGE": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "per",
        "period",
        "filter"
      ],
      "properties": {
        "per": {
          "type": "string",
          "enum": [
            "day",
            "week",
            "month"
          ]
        },
        "period": {
          "$ref": "#/$defs/Period"
        },
        "filter": {
          "$ref": "#/$defs/Filter"
        }
      }
    },
    "P_PL-INCOME": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "period",
        "filter"
      ],
      "properties": {
        "period": {
          "$ref": "#/$defs/Period"
        },
        "filter": {
          "$ref": "#/$defs/Filter"
        }
      }
    },
    "P_PL-SAVED": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "period"
      ],
      "properties": {
        "period": {
          "$ref": "#/$defs/Period"
        }
      }
    },
    "P_PL-BILLS-DUE": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "windowDays"
      ],
      "properties": {
        "windowDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        }
      }
    },
    "P_PL-BUDGET-LEFT": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug"
      ],
      "properties": {
        "slug": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "groceries",
            "dining",
            "transport",
            "bills",
            "housing",
            "shopping",
            "debt",
            "subscriptions",
            "health",
            "education",
            "entertainment",
            "family_giving",
            "savings",
            "income",
            "cash",
            "instapay",
            null
          ]
        }
      }
    },
    "P_PL-SAFE-SPEND": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {}
    },
    "P_PL-BALANCE": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref"
      ],
      "properties": {
        "ref": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^⟦(ACCOUNT|CARD|BANK)_[1-9]⟧$"
        }
      }
    },
    "P_PL-WHATIF-CUT": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "mode",
        "months"
      ],
      "properties": {
        "target": {
          "$ref": "#/$defs/Filter"
        },
        "mode": {
          "$ref": "#/$defs/Mode"
        },
        "months": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        }
      }
    },
    "P_PL-WHATIF-SAVE": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "months"
      ],
      "properties": {
        "amount": {
          "$ref": "#/$defs/Amount"
        },
        "months": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        }
      }
    },
    "P_PL-SUGGEST": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency"
      ],
      "properties": {
        "currency": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{3}$"
        }
      }
    },
    "P_PL-INVEST": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "instruments",
        "horizonMonths"
      ],
      "properties": {
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "whatIf",
            "amount"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "savedLastPeriod",
                "whatIf",
                "amount"
              ]
            },
            "whatIf": {
              "anyOf": [
                {
                  "$ref": "#/$defs/P_PL-WHATIF-CUT"
                },
                {
                  "type": "null"
                }
              ]
            },
            "amount": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Amount"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "instruments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "string",
            "enum": [
              "gold",
              "usd",
              "certificate",
              "index"
            ]
          }
        },
        "horizonMonths": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        }
      }
    },
    "P_PL-FALLBACK": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "enum": [
            "unsupported",
            "ambiguous",
            "zakah",
            "noData"
          ]
        }
      }
    },
    "P_PL-REFUSE": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "selfHarm"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "enum": [
            "offTopic",
            "unsafe",
            "specificPick"
          ]
        },
        "selfHarm": {
          "type": "boolean"
        }
      }
    }
  }
}
